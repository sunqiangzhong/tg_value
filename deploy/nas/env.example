TG_VAULT_IMAGE=YOUR_DOCKERHUB_USERNAME/tg-vault:docker-hub
WEB_PORT=8080
# Optional for local access; required for cloud storage OAuth. No trailing slash.
PUBLIC_URL=
# Set true when accessing through HTTPS.
COOKIE_SECURE=false
# For HTTPS reverse proxies, set their IP or trusted subnet explicitly.
TRUST_PROXY=loopback
# Optional outbound proxies. GramJS MTProto requires an explicit SOCKS URL.
# A Clash/Mihomo mixed port supports both values on the same host and port.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=1
TELEGRAM_PROXY_URL=
