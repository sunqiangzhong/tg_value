TG_VAULT_IMAGE=YOUR_DOCKERHUB_USERNAME/tg-vault:docker-hub
WEB_PORT=8080
# Optional for local access; required for cloud storage OAuth. No trailing slash.
PUBLIC_URL=
# Set true when accessing through HTTPS.
COOKIE_SECURE=false
# For HTTPS reverse proxies, set their IP or trusted subnet explicitly.
TRUST_PROXY=loopback
# Optional Clash/Mihomo mixed proxy. This one setting configures HTTP and MTProto.
PROXY_HOST=
# Advanced overrides:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=1
TELEGRAM_PROXY_URL=
